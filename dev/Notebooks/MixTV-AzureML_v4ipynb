        "# =====================================================================\n",
        "# 13. PIPELINE GENERALIZADO (acepta cualquier lista de variables) Y\n",
        "# DEFINICIÓN DE LAS 3 VARIANTES A / B / C-proxy\n",
        "# =====================================================================\n",
        "\n",
        "def crear_xgboost_generico(variables):\n",
        "    variables_num = [c for c in variables if c != \"Cluster\"]\n",
        "\n",
        "    numeric_transformer = Pipeline([\n",
        "        (\"imputer\", SimpleImputer(strategy=\"median\", add_indicator=True))\n",
        "    ])\n",
        "\n",
        "    transformers = [(\"num\", numeric_transformer, variables_num)]\n",
        "\n",
        "    if \"Cluster\" in variables:\n",
        "        categorical_transformer = Pipeline([\n",
        "            (\"imputer\", SimpleImputer(strategy=\"most_frequent\")),\n",
        "            (\"onehot\", OneHotEncoder(handle_unknown=\"ignore\"))\n",
        "        ])\n",
        "        transformers.append((\"cat\", categorical_transformer, [\"Cluster\"]))\n",
        "\n",
        "    preprocessor = ColumnTransformer(transformers)\n",
        "\n",
        "    modelo = XGBRegressor(\n",
        "        objective=\"reg:squarederror\",\n",
        "        n_estimators=500,\n",
        "        learning_rate=0.03,\n",
        "        max_depth=5,\n",
        "        min_child_weight=5,\n",
        "        subsample=0.8,\n",
        "        colsample_bytree=0.8,\n",
        "        reg_alpha=0.1,\n",
        "        reg_lambda=1.0,\n",
        "        random_state=42,\n",
        "        n_jobs=-1\n",
        "    )\n",
        "\n",
        "    return Pipeline([\n",
        "        (\"preprocessor\", preprocessor),\n",
        "        (\"model\", modelo)\n",
        "    ])\n",
        "\n",
        "\n",
        "def variables_modelo_a(h):\n",
        "    return VARIABLES_HISTORICAS\n",
        "\n",
        "def variables_modelo_b(h):\n",
        "    return VARIABLES_HISTORICAS + [f\"MixTV_Pred_T{h}\"]\n",
        "\n",
        "def variables_modelo_c_proxy(h):\n",
        "    # PROXY: usa el Churn REAL (no un pronóstico) solo para explorar\n",
        "    # si la señal de churn ayuda. No es el Modelo C definitivo --\n",
        "    # eso requiere un histórico real de Churn_Pred.\n",
        "    return VARIABLES_HISTORICAS + [f\"MixTV_Pred_T{h}\", \"Churn\"]\n",
        "\n",
        "VARIANTES = {\n",
        "    \"A_Historico\": variables_modelo_a,\n",
        "    \"B_MasMixTVPred\": variables_modelo_b,\n",
        "    \"C_Proxy_MasChurnReal\": variables_modelo_c_proxy\n",
        "}\n",
