        "# =====================================================================\n",
        "# 5. Construye la tabla de entrenamiento de MixTV\n",
        "# =====================================================================\n",
        "MES_INCOMPLETO = 202608\n",
        "\n",
        "df[\"Fecha\"] = pd.to_datetime(df[\"Fecha\"])\n",
        "\n",
        "base = df[\n",
        "    (df[\"AnioMes\"] != MES_INCOMPLETO) &\n",
        "    (df[\"MixTV\"].notna())\n",
        "].copy()\n",
        "\n",
        "m = base[\n",
        "    [\n",
        "        \"Cluster\", \"AnioMes\", \"Mes\", \"Trimestre\",\n",
        "        \"Instalaciones\", \"BaseDeUsuarios\",\n",
        "        \"MixTV_M1\", \"MixTV_M2\", \"MixTV_M3\",\n",
        "        \"MixTV_Prom3M\", \"MixTV_Prom6M\",\n",
        "        \"MixTV_Delta1M\", \"MixTV_Delta3M\",\n",
        "        \"Instalaciones_M1\", \"MixTV_T1\"\n",
        "    ]\n",
        "].copy()\n",
        "\n",
        "# MixTV en puntos porcentuales\n",
        "m[\"MixTV\"] = base[\"MixTV\"] #* 100.0\n",
        "\n",
        "# IMPORTANTE: si estas columnas vienen en escala 0-1, pasarlas también a 0-100\n",
        "cols_mixtv = [\n",
        "    \"MixTV_M1\", \"MixTV_M2\", \"MixTV_M3\",\n",
        "    \"MixTV_Prom3M\", \"MixTV_Prom6M\",\n",
        "    \"MixTV_Delta1M\", \"MixTV_Delta3M\"\n",
        "]\n",
        "\n",
        "m[cols_mixtv] = m[cols_mixtv] #* 100.0\n",
        "\n",
        "m = (\n",
        "    m.sort_values([\"Cluster\", \"AnioMes\"])\n",
        "     .reset_index(drop=True)\n",
        ")\n",
        "\n",
        "g = m.groupby(\"Cluster\")\n",
        "\n",
        "\n",
        "# =====================================================================\n",
        "# TARGETS\n",
        "# =====================================================================\n",
        "\n",
        "#m[\"MixTV_T1\"] = g[\"MixTV\"].shift(-1)\n",
        "m[\"MixTV_T2\"] = g[\"MixTV\"].shift(-2)\n",
        "m[\"MixTV_T3\"] = g[\"MixTV\"].shift(-3)\n",
        "\n",
        "\n",
        "# =====================================================================\n",
        "# MIXTV DELTA 6 MESES\n",
