      "source": [
        "# =====================================================================\n",
        "# 6. REENTRENAMIENTO FINAL \n",
        "# =====================================================================\n",
        "\n",
        "CORTE_PRODUCCION = {\n",
        "    1: 202606,  # T1: junio -> julio\n",
        "    2: 202605,  # T2: mayo -> julio\n",
        "    3: 202604   # T3: abril -> julio\n",
        "}\n",
        "\n",
        "modelos_finales = {}\n",
        "\n",
        "for h in [1, 2, 3]:\n",
        "\n",
        "    objetivo = f\"MixTV_T{h}\"\n",
        "\n",
        "    # ---------------------------------------------------------\n",
        "    # TRAIN:\n",
        "    # - Base >= piso\n",
        "    # - Target obligatorio\n",
        "    # - Features pueden tener NaN, los imputa el pipeline\n",
        "    # ---------------------------------------------------------\n",
        "    train_final = (\n",
        "        m[\n",
        "            (m[\"AnioMes\"] <= CORTE_PRODUCCION[h]) &\n",
        "            (m[\"Base_M1\"] >= PISO) &\n",
        "            (m[objetivo].notna())\n",
        "        ]\n",
        "        .copy()\n",
        "        .reset_index(drop=True)\n",
        "    )\n",
        "\n",
        "    # XGBoost tampoco acepta infinito.\n",
        "    # Lo convertimos a NaN para que SimpleImputer lo resuelva.\n",
        "    train_final[VARIABLES] = (\n",
        "        train_final[VARIABLES]\n",
        "        .replace([np.inf, -np.inf], np.nan)\n",
        "    )\n",
        "\n",
        "    # Seguridad para el target\n",
        "    train_final = train_final[\n",
        "        np.isfinite(train_final[objetivo])\n",
        "    ].reset_index(drop=True)\n",
        "\n",
        "    print(\n",
        "        f\"T{h} | registros={len(train_final)} | \"\n",
        "        f\"target nulos={train_final[objetivo].isna().sum()}\"\n",
        "    )\n",
        "\n",
        "    modelo = crear_xgboost()\n",
        "\n",
        "    modelo.fit(\n",
        "        train_final[VARIABLES],\n",
        "        train_final[objetivo]\n",
        "    )\n",
        "\n",
        "    modelos_finales[f\"T{h}\"] = modelo\n",
        "\n",
        "    print(\n",
        "        f\"T{h} entrenado | \"\n",
        "        f\"hasta {CORTE_PRODUCCION[h]} | \"\n",
        "        f\"registros={len(train_final)}\"\n",
        "    )\n",
        "\n",
        "\n",
        "# =====================================================================\n",
        "# 7. SCORING FUTURO\n",
        "#\n",
        "# Julio -> agosto / septiembre / octubre\n",
        "# =====================================================================\n",
        "\n",
        "MES_ORIGEN_PRODUCCION = 202607\n",
        "\n",
        "score = (\n",
        "    m[\n",
        "        m[\"AnioMes\"] == MES_ORIGEN_PRODUCCION\n",
        "    ]\n",
        "    .copy()\n",
        "    .reset_index(drop=True)\n",
        ")\n",
        "\n",
        "# No hacemos dropna.\n",
        "# Los NaN los maneja SimpleImputer.\n",
        "score[VARIABLES] = (\n",
        "    score[VARIABLES]\n",
        "    .replace([np.inf, -np.inf], np.nan)\n",
        ")\n",
        "\n",
        "print(\"Clusters para scoring:\", len(score))\n",
        "print(\"Clusters únicos:\", score[\"Cluster\"].nunique())"
