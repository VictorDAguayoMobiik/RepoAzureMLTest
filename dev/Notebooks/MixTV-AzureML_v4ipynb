    {
      "cell_type": "code",
      "source": [
        "# =====================================================================\n",
        "# 18. SESGO (error con signo) por rango de instalaciones y horizonte\n",
        "# =====================================================================\n",
        "#\n",
        "# Error = MixTV_Real - MixTV_Pred (ya está en df_detalle_test)\n",
        "# Sesgo positivo -> el modelo SUBESTIMA (predijo de menos)\n",
        "# Sesgo negativo -> el modelo SOBREESTIMA (predijo de más)\n",
        "# =====================================================================\n",
        "\n",
        "def resumen_rango_con_sesgo(g):\n",
        "    suma_real = g[\"MixTV_Real\"].abs().sum()\n",
        "    return pd.Series({\n",
        "        \"Registros\": len(g),\n",
        "        \"MAE\": g[\"ErrorAbs\"].mean(),\n",
        "        \"WAPE\": 100 * g[\"ErrorAbs\"].sum() / suma_real if suma_real > 0 else np.nan,\n",
        "        \"MedianaAPE\": g[\"APE\"].median(),\n",
        "        \"Sesgo\": g[\"Error\"].mean(),\n",
        "        \"SesgoMediana\": g[\"Error\"].median()\n",
        "    })\n",
        "\n",
        "detalle_por_rango = (\n",
        "    df_detalle_test\n",
        "    .groupby([\"Horizonte\", \"RangoInstalaciones\"])\n",
        "    .apply(resumen_rango_con_sesgo)\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "display(detalle_por_rango)\n",
        "\n",
        "# --- Sesgo global por horizonte (para el resumen ejecutivo) ---\n",
        "sesgo_global = (\n",
        "    df_detalle_test\n",
        "    .groupby(\"Horizonte\")[\"Error\"]\n",
        "    .agg(Sesgo=\"mean\", SesgoMediana=\"median\")\n",
        "    .reset_index()\n",
        ")\n",
        "print(\"\\nSesgo global por horizonte:\")\n",
        "display(sesgo_global)\n",
        "\n",
        "\n",
        "# =====================================================================\n",
        "# 19. GRÁFICA: Sesgo por rango, con línea en cero como referencia\n",
        "# =====================================================================\n",
