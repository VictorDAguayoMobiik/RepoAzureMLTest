        "\n",
        "if \"CORTE_TEST_FINAL\" not in dir():\n",
        "    CORTE_TEST_FINAL = {1: 202604, 2: 202603, 3: 202602}\n",
        "if \"ORIGEN_TEST_FINAL\" not in dir():\n",
        "    ORIGEN_TEST_FINAL = {1: [202605, 202606], 2: [202604, 202605], 3: [202603, 202604]}\n",
        "\n",
        "resultados_instalaciones = []\n",
        "\n",
        "for h in [1, 2, 3]:\n",
        "    objetivo = f\"Instalaciones_T{h}\"\n",
        "\n",
        "    for nombre_variante, obtener_vars in VARIANTES.items():\n",
        "        vars_modelo = obtener_vars(h)\n",
        "\n",
        "        d = (\n",
        "            m[\n",
        "                (m[\"Base_M1\"] >= PISO) &\n",
        "                (m[objetivo].notna())\n",
        "            ]\n",
        "            .copy()\n",
        "            .reset_index(drop=True)\n",
        "        )\n",
        "\n",
        "        train = d[d[\"AnioMes\"] <= CORTE_TEST_FINAL[h]].copy()\n",
