        "\n",
        "# =====================================================================\n",
        "# 3. TEST FINAL - JUNIO Y JULIO 2026\n",
        "# =====================================================================\n",
        "\n",
        "# El último target usado en entrenamiento es mayo 2026.\n",
        "CORTE_TEST_FINAL = {\n",
        "    1: 202604,  # T1: abril -> mayo\n",
        "    2: 202603,  # T2: marzo -> mayo\n",
        "    3: 202602   # T3: febrero -> mayo\n",
        "}\n",
        "\n",
        "# Todos los horizontes terminan prediciendo junio y julio.\n",
        "ORIGEN_TEST_FINAL = {\n",
        "    1: [202605, 202606],  # mayo/junio -> junio/julio\n",
        "    2: [202604, 202605],  # abril/mayo -> junio/julio\n",
        "    3: [202603, 202604]   # marzo/abril -> junio/julio\n",
        "}\n",
        "\n",
        "resultados_test = []\n",
        "detalle_test = []\n",
        "\n",
        "for h in [1, 2, 3]:\n",
        "\n",
        "    objetivo = f\"MixTV_T{h}\"\n",
        "\n",
        "    d = (\n",
        "        m[\n",
        "            (m[\"Base_M1\"] >= PISO) &\n",
        "            (m[objetivo].notna())\n",
        "        ]\n",
        "        .copy()\n",
        "        .reset_index(drop=True)\n",
        "    )\n",
        "\n",
        "    train = ( d[d[\"AnioMes\"] <= CORTE_TEST_FINAL[h]].copy()\n",
        "                .reset_index(drop=True) \n",
        "            )\n",
        "    \n",
        "    test = d[d[\"AnioMes\"].isin(ORIGEN_TEST_FINAL[h])].copy()\n",
        "\n",
        "    print(f\"\\nTEST FINAL T{h}\")\n",
        "    print(\"Train hasta:\", CORTE_TEST_FINAL[h])\n",
        "    print(\"Origen test:\", ORIGEN_TEST_FINAL[h])\n",
        "    print(\"Targets:\", [mover_mes(x, h) for x in ORIGEN_TEST_FINAL[h]])\n",
        "    print(\"Train:\", len(train), \"| Test:\", len(test))\n",
        "\n",
        "    modelo = crear_xgboost()\n",
        "    modelo.fit(train[VARIABLES], train[objetivo])\n",
        "\n",
        "    pred = np.clip(modelo.predict(test[VARIABLES]), 0, 1)\n",
        "    real = test[objetivo].values\n",
        "    baseline = test[\"MixTV\"].values\n",
        "\n",
        "    error = np.abs(real - pred)\n",
        "    error_baseline = np.abs(real - baseline)\n",
        "\n",
        "    mae = error.mean()\n",
        "    rmse = np.sqrt(np.mean((real - pred) ** 2))\n",
        "\n",
        "    suma_real = np.abs(real).sum()\n",
        "\n",
        "    wape = 100 * error.sum() / suma_real if suma_real > 0 else np.nan\n",
        "    mae_baseline = error_baseline.mean()\n",
        "    wape_baseline = 100 * error_baseline.sum() / suma_real if suma_real > 0 else np.nan\n",
        "\n",
        "    mejora = (\n",
        "        100 * (error_baseline.sum() - error.sum()) / error_baseline.sum()\n",
        "        if error_baseline.sum() > 0 else np.nan\n",
        "    )\n",
        "\n",
        "    resultados_test.append({\n",
        "        \"Horizonte\": f\"T{h}\",\n",
        "        \"MAE\": round(mae, 3),\n",
        "        \"RMSE\": round(rmse, 3),\n",
        "        \"WAPE\": round(wape, 2),\n",
        "        \"MAE_Baseline\": round(mae_baseline, 3),\n",
        "        \"WAPE_Baseline\": round(wape_baseline, 2),\n",
        "        \"MejoraVsBaseline\": round(mejora, 1),\n",
        "        \"LeGanaBaseline\": \"SI\" if error.sum() < error_baseline.sum() else \"NO\",\n",
        "        \"Train\": len(train),\n",
        "        \"Test\": len(test)\n",
        "    })\n",
        "\n",
        "    tmp = test[[\"Cluster\", \"AnioMes\", \"MixTV\", objetivo]].copy()\n",
        "    tmp = tmp.rename(columns={\n",
        "        \"MixTV\": \"MixTV_Origen\",\n",
        "        objetivo: \"MixTV_Real\"\n",
        "    })\n",
        "\n",
        "    tmp[\"Horizonte\"] = f\"T{h}\"\n",
        "    tmp[\"MesObjetivo\"] = tmp[\"AnioMes\"].apply(lambda x: mover_mes(x, h))\n",
        "    tmp[\"MixTV_Pred\"] = pred\n",
        "    tmp[\"Error\"] = tmp[\"MixTV_Real\"] - tmp[\"MixTV_Pred\"]\n",
        "    tmp[\"ErrorAbs\"] = tmp[\"Error\"].abs()\n",
        "\n",
        "    detalle_test.append(tmp)\n",
        "\n",
        "# =====================================================================\n",
        "# 4. DETALLE DEL TEST FINAL\n",
        "# =====================================================================\n",
        "\n",
        "df_detalle_test = pd.concat(\n",
        "    detalle_test,\n",
        "    ignore_index=True\n",
        ")\n",
        "\n",
        "display(df_detalle_test)\n",
        "\n",
        "df_resultados_test = pd.DataFrame(resultados_test)\n",
        "\n",
        "display(df_resultados_test)"
      ],
