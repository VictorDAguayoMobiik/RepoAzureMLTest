        "\n",
        "        modelo = crear_xgboost_generico(vars_modelo)\n",
        "        modelo.fit(train[vars_modelo], train[objetivo])\n",
        "\n",
        "        pred = np.clip(modelo.predict(test[vars_modelo]), 0, None)\n",
        "        real = test[objetivo].values\n",
        "\n",
        "        error_abs = np.abs(real - pred)\n",
        "        suma_real = np.abs(real).sum()\n",
        "\n",
        "        mae = error_abs.mean()\n",
        "        wape = 100 * error_abs.sum() / suma_real if suma_real > 0 else np.nan\n",
